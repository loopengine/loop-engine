{
  "name": "@loop-engine/provider-json",
  "version": "0.1.0",
  "private": false,
  "description": "Reference JSON/file evidence provider (ADR-0005 Set 0 — Alpine adapter)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "node -e \"console.log('provider-json lint')\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@loop-engine/evidence": "workspace:*",
    "@loop-engine/provider-api": "workspace:*"
  },
  "devDependencies": {
    "@loop-engine/golden-exemplars": "workspace:*",
    "@loop-engine/provider-conformance": "workspace:*",
    "@types/node": "^20.14.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
